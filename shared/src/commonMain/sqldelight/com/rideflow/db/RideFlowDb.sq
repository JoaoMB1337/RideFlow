CREATE TABLE Train (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date INTEGER NOT NULL,
    duration INTEGER DEFAULT 0,
    distance REAL DEFAULT 0.0,
    avgHeartRate INTEGER DEFAULT 0,
    avgPower INTEGER DEFAULT 0,
    avgSpeed REAL DEFAULT 0.0,
    avgResistance INTEGER DEFAULT 0,
    maxHeartRate INTEGER DEFAULT 0,
    maxPower INTEGER DEFAULT 0,
    maxSpeed REAL DEFAULT 0.0,
    maxResistance INTEGER DEFAULT 0,
    calories INTEGER DEFAULT 0,
    name TEXT,
    notes TEXT
);

CREATE TABLE TrainingData (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    idTrain INTEGER NOT NULL,
    timestampOffset INTEGER NOT NULL,
    heartRate INTEGER,
    power INTEGER,
    speed REAL,
    distance REAL,
    resistance INTEGER,
    FOREIGN KEY (idTrain) REFERENCES Train(id) ON DELETE CASCADE
);

-- Sem este índice, ler os samples de um treino (e o ON DELETE CASCADE) faz scan à tabela toda.
CREATE INDEX TrainingData_idTrain ON TrainingData(idTrain);

-- Consultas para Train
insertTrain:
INSERT INTO Train(date)
VALUES (?);

selectAllTrains:
SELECT * FROM Train ORDER BY date DESC;

selectTrainById:
SELECT * FROM Train WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

updateTrainSummary:
UPDATE Train
SET duration = ?, distance = ?, avgHeartRate = ?, avgPower = ?, avgSpeed = ?, avgResistance = ?, maxHeartRate = ?, maxPower = ?, maxSpeed = ?, maxResistance = ?, calories = ?
WHERE id = ?;

updateTrainInfo:
UPDATE Train SET name = ?, notes = ? WHERE id = ?;

-- Treinos cujo resumo nunca foi escrito (app morta a meio do treino ou falha no stop).
-- Um treino terminado tem sempre duration >= 1: só há samples a partir do segundo 1 e os
-- treinos sem samples são apagados no stop.
selectUnfinishedTrainIds:
SELECT id FROM Train WHERE duration IS NULL OR duration = 0;

deleteTrain:
DELETE FROM Train WHERE id = ?;

-- Consultas para TrainingData
insertTrainingData:
INSERT INTO TrainingData(idTrain, timestampOffset, heartRate, power, speed, distance, resistance)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectDataForTrain:
SELECT * FROM TrainingData WHERE idTrain = ? ORDER BY timestampOffset ASC;
